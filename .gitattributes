# Preserve original upstream font and license bytes on every checkout.
/third_party/desktop_lyric/assets/fonts/* -text
/licenses/SOURCE-HAN-SANS/* -text
/licenses/GOOGLE-SANS/* -text
/licenses/PRETENDARD/* -text
# These pinned upstream notices retain their original CRLF/trailing spaces.
/licenses/GOOGLE-SANS/OFL.txt whitespace=cr-at-eol,-blank-at-eol
/licenses/GOOGLE-SANS/TRADEMARKS.md whitespace=cr-at-eol,-blank-at-eol
/licenses/PRETENDARD/OFL.txt whitespace=cr-at-eol,-blank-at-eol
